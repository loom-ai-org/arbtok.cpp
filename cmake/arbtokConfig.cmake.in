@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(orthography2ipa)

if(NOT TARGET arbtok::onnxruntime)
    add_library(arbtok::onnxruntime SHARED IMPORTED)
    set_target_properties(arbtok::onnxruntime PROPERTIES IMPORTED_LOCATION "@ARBTOK_ONNXRUNTIME_CONFIG_LOCATION@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/arbtokTargets.cmake")
check_required_components(arbtok)
